# Per-user cluster settings. Copy to site.env (git-ignored) and fill in:
#   cp cloud/slurm/site.env.example cloud/slurm/site.env
# List your Slurm accounts with `sacctmgr show assoc user=$USER` (some sites also provide a shortcut such as `my_accounts`).

ACCOUNT=your_slurm_account          # billing account for GPU jobs
PARTITION=gpu                       # GPU partition name on your cluster
TIME=08:00:00                       # must not exceed the account's MaxWall
# Safety net: jobs refuse to run unless the account starts with this prefix
# (useful when you hold several allocations and only one may be used for this project).
ALLOWED_ACCOUNT_PREFIX=your_slurm_account
